{
  "name": "remotion-app",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/media": "4.0.535",
    "mediabunny": "1.61.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.535",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "test-media": "bash scripts/make-test-media.sh",
    "render:test": "remotion render TestComposition out/test-composition.mp4 --codec=h264 --pixel-format=yuv420p --image-format=jpeg --crf=18 --color-space=bt709 --audio-codec=aac --log=verbose",
    "render:footage": "remotion render FootageComposite out/footage-composite.mp4 --codec=h264 --pixel-format=yuv420p --image-format=jpeg --crf=18 --color-space=bt709 --audio-codec=aac --log=verbose",
    "render:overlay": "remotion render Overlay out/overlay-alpha.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png --log=verbose",
    "verify": "node scripts/verify-render.mjs",
    "test:render": "npm run test-media && npm run render:test && npm run render:footage && npm run render:overlay && npm run verify"
  }
}
